# Wireshark preferences — DNS-Profile

# ── Column definitions ────────────────────────────────────────────────────────
column.format:
	"No.", "%m",
	"Time Delta", "%Yt",
	"Source IP", "%s",
	"Dest IP", "%d",
	"Transaction ID", "%Cus:dns.id:0:R",
	"Query/Response", "%Cus:dns.flags.response:0:R",
	"Query Name", "%Cus:dns.qry.name:0:R",
	"Query Type", "%Cus:dns.qry.type:0:R",
	"Response Code", "%Cus:dns.flags.rcode:0:R",
	"Answer Count", "%Cus:dns.count.answers:0:R",
	"TTL", "%Cus:dns.resp.ttl:0:R",
	"Resolved IP", "%Cus:dns.a:0:R",
	"Info", "%i"

# ── Name resolution ───────────────────────────────────────────────────────────
nameres.network_name: FALSE
nameres.dns_pkt_addr_resolution: FALSE
nameres.use_external_name_resolver: FALSE

# ── DNS dissector ─────────────────────────────────────────────────────────────
dns.desegment_dns_messages: TRUE
