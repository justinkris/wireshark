# Wireshark preferences — HTTP-Profile

# Reassemble HTTP request/response bodies spanning multiple TCP segments
http.desegment_headers: TRUE
http.desegment_body: TRUE

# Uncompress compressed bodies (gzip, deflate, etc.)
http.decompress_body: TRUE

# Track HTTP request/response pairs
http.dechunk_body: TRUE

# TCP — required for HTTP stream reassembly
tcp.desegment_tcp_streams: TRUE
tcp.reassemble_out_of_order: TRUE
tcp.relative_sequence_numbers: TRUE
tcp.calculate_timestamps: TRUE
tcp.check_checksum: FALSE

# TLS — for HTTPS inspection (requires key log file)
tls.desegment_ssl_records: TRUE
tls.desegment_ssl_application_data: TRUE
