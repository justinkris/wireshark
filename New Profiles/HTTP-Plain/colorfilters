# Wireshark Color filter file — HTTP-Plain
# Format: @name@filter@[fg_r,fg_g,fg_b][bg_r,bg_g,bg_b]  (16-bit 0-65535)
# First match wins.
# NOTE: "HTTP Request" fires before "CONNECT Tunnel" — move CONNECT above HTTP Request
#       if you want CONNECT packets to show purple instead of light blue.

@HTTP 5xx@http.response.code >= 500@[65535,65535,65535][52428,0,0]
@HTTP 4xx@http.response.code >= 400 && http.response.code < 500@[65535,65535,65535][65535,26214,0]
@HTTP 3xx@http.response.code >= 300 && http.response.code < 400@[0,0,0][65535,52428,0]
@HTTP 2xx@http.response.code >= 200 && http.response.code < 300@[0,0,0][47288,57568,47288]
@HTTP Request@http.request@[0,0,0][43176,55512,60138]
@CONNECT Tunnel@http.request.method == "CONNECT"@[65535,65535,65535][39835,22873,46774]
@TCP RST@tcp.flags.reset == 1@[65535,65535,65535][52428,0,0]
@Retransmission@tcp.analysis.retransmission@[0,0,0][65535,46003,47802]
