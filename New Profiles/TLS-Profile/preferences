# Wireshark preferences — TLS-Profile

# Reassemble TLS records spanning multiple TCP segments
tls.desegment_ssl_records: TRUE

# Reassemble TLS application data spanning multiple records
tls.desegment_ssl_application_data: TRUE

# Show certificate details in packet list
tls.show_ignored_cert_errors: TRUE

# TCP — needed for TLS reassembly
tcp.desegment_tcp_streams: TRUE
tcp.reassemble_out_of_order: TRUE
tcp.relative_sequence_numbers: TRUE
tcp.calculate_timestamps: TRUE
tcp.check_checksum: FALSE
